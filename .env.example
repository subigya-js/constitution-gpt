# Required: OpenAI creates embeddings and generates constitutional answers.
OPENAI_API_KEY=your_openai_api_key

# Optional: provider timeout and retry controls.
OPENAI_REQUEST_TIMEOUT_SECONDS=45
OPENAI_MAX_RETRIES=2

# Required: browser origins allowed to call FastAPI. Separate multiple origins
# with commas; do not include paths or trailing slashes.
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Required by the current API runtime. Use a URL reachable from your machine.
DATABASE_URL=postgresql://username:password@host:5432/database

# Optional: API capacity and dependency health controls.
MAX_CONCURRENT_RAG_REQUESTS=3
RAG_QUEUE_TIMEOUT_SECONDS=1
RAG_REQUEST_TIMEOUT_SECONDS=90
CHROMA_HEALTH_TIMEOUT_SECONDS=5

# Required: copy these values from your Chroma Cloud project.
CHROMA_API_KEY=your_chroma_cloud_api_key
CHROMA_TENANT=your_chroma_tenant
CHROMA_DATABASE=your_chroma_database
CHROMA_COLLECTION=constitution_english

# Optional: omit this unless your Chroma project uses a custom cloud host.
# CHROMA_HOST=your_custom_chroma_host
